# Copy to .dev.vars at the repository root for LOCAL Wrangler use.
# Keep real secrets out of Git and chat. Never prefix them with VITE_.
# Local feature flag/origin are supplied by npm run dev:pages.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple requires the approved HTTPS preview, not localhost.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# One-line PKCS#8 PEM with literal \n separators is accepted.
APPLE_PRIVATE_KEY=
# 32 random bytes encoded as 64 hex characters; retain securely for decryption.
APPLE_TOKEN_ENCRYPTION_KEY=
# Random server-only secret for hashing request IPs for short-lived login throttles.
AUTH_RATE_LIMIT_SECRET=
