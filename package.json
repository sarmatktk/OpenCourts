{
  "name": "opencourts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_USE_ENV_PROXY=1 vite",
    "build": "tsc -b && tsc -p functions/tsconfig.json && vite build",
    "build:watch": "vite build --watch",
    "preview": "wrangler pages dev dist --compatibility-date=2025-01-01",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2025-01-01",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "import:courts": "node scripts/import-court-catalog.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.55.0"
  }
}
