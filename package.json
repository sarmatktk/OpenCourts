{
  "name": "opencourts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "build:frontend": "tsc -b && vite build --outDir dist-frontend",
    "build:frontend:preview": "cross-env VITE_PLAY_TOGETHER=true tsc -b && cross-env VITE_PLAY_TOGETHER=true vite build --outDir dist-preview && node scripts/prepare-preview-pages.mjs",
    "build:frontend:release": "cross-env VITE_PLAY_TOGETHER=true npm run build:frontend && node scripts/prepare-production-pages.mjs dist-frontend",
    "deploy:pages:assets": "node scripts/deploy-pages-assets.mjs",
    "typecheck:api": "tsc -p backend/tsconfig.json",
    "build:release": "cross-env VITE_PLAY_TOGETHER=true npm run build -- --outDir dist-release && node scripts/prepare-production-pages.mjs",
    "dev": "cross-env NODE_USE_ENV_PROXY=1 vite",
    "build": "tsc -b && tsc -p functions/tsconfig.json && vite build",
    "build:dev": "cross-env VITE_PLAY_TOGETHER=true npm run build && node scripts/prepare-dev-pages.mjs",
    "build:watch": "vite build --watch",
    "preview": "wrangler pages dev dist --compatibility-date=2025-01-01",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2025-01-01",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "import:courts": "node scripts/import-court-catalog.mjs",
    "dev:db:migrate": "node scripts/dev-environment.mjs migrate",
    "dev:db:seed": "node scripts/dev-environment.mjs seed",
    "dev:db:seed-games": "node scripts/dev-environment.mjs seed-games",
    "dev:db:verify": "node scripts/dev-environment.mjs verify",
    "dev:pages": "node scripts/dev-environment.mjs serve"
  },
  "dependencies": {
    "@mmmike/web-push": "^1.5.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.19.0",
    "oauth4webapi": "^3.8.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=22.21.0"
  }
}
